# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional comma-separated backup Gemini API keys for automatic failover if primary hits rate limits
GEMINI_API_KEYS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Live Broker Execution Bridges (server-side only; never exposed to client bundle)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# Optional Web Push VAPID Keys (auto-generated in-memory at runtime if omitted)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@mullahtracker.app
