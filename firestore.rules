rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidTradingState(data, userId) {
      return data.keys().hasAll(['uid', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'paperBalance', 'paperPositions', 'closedTrades', 'trackedSignals', 'customBots', 'updatedAt'])
        && data.uid is string
        && data.uid.size() > 0
        && data.uid.size() <= 128
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.updatedAt is string
        && data.updatedAt.size() <= 64
        && (!('paperBalance' in data) || (data.paperBalance is number && data.paperBalance >= 0))
        && (!('paperPositions' in data) || (data.paperPositions is list && data.paperPositions.size() <= 100))
        && (!('closedTrades' in data) || (data.closedTrades is list && data.closedTrades.size() <= 200))
        && (!('trackedSignals' in data) || (data.trackedSignals is list && data.trackedSignals.size() <= 120))
        && (!('customBots' in data) || (data.customBots is list && data.customBots.size() <= 40));
    }

    // Test collection for initial connectivity validation
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile: only owner can read and write
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // User financial records: only owner can access
    match /users/{userId}/finance/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // User trading state (Scorecard, Paper Positions/Trades, Custom Bots): strictly owner-isolated & schema-validated
    match /users/{userId}/trading/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && isValidId(docId) && request.auth.uid == userId && isValidTradingState(incoming(), userId);
      allow update: if isSignedIn() && isValidId(docId) && request.auth.uid == userId
        && isValidTradingState(incoming(), userId)
        && incoming().uid == resource.data.uid;
      allow delete: if isSignedIn() && isValidId(docId) && request.auth.uid == userId;
    }
  }
}
